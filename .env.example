# Authentication (required)
# The server hashes this token; clients send `Authorization: Ripclone <sha256>`.
RIPCLONE_SERVER_TOKEN=change-me-in-production

# GitHub App credential broker (optional). When RIPCLONE_GITHUB_APP_ID is set,
# the server authenticates upstream as a GitHub App installation: it signs a
# short-lived app JWT and exchanges it for an installation access token (cached
# until shortly before it expires) instead of using a static token. Provide the
# private key inline (RIPCLONE_GITHUB_APP_PRIVATE_KEY). RIPCLONE_GITHUB_API_BASE
# overrides the REST API base for GitHub Enterprise.
# RIPCLONE_GITHUB_APP_ID=123456
# RIPCLONE_GITHUB_APP_INSTALLATION_ID=7891011
# RIPCLONE_GITHUB_APP_PRIVATE_KEY=
# RIPCLONE_GITHUB_API_BASE=https://api.github.com

# Client artifact cache directory (opt-in).
RIPCLONE_CACHE_DIR=./data/cache

# Base URL for upstream git origins (e.g. your GitHub App proxy).
# Default is `https://github.com`.
# RIPCLONE_ORIGIN_BASE=https://github.com

# Rate limiter. The burst is 6x the per-second rate. Tests override this to
# avoid throttling.
RIPCLONE_RATE_LIMIT_PER_SEC=10

# ------------------------------------------------------------------------------
# Storage backend
# ------------------------------------------------------------------------------
# Local filesystem is used unless RIPCLONE_S3_BUCKET is set.
# To use Tigris / S3-compatible storage, set these (the bucket needs the endpoint):
RIPCLONE_S3_ENDPOINT=
RIPCLONE_S3_REGION=us-east-1
RIPCLONE_S3_BUCKET=
# Optional prefix for all objects, e.g. "prod/". Must end with `/` if non-empty.
RIPCLONE_S3_PREFIX=

# AWS-style credentials for the S3-compatible store.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ------------------------------------------------------------------------------
# S3 local build-cache cleanup
# ------------------------------------------------------------------------------
# These settings apply only with S3-compatible durable storage. They can remove
# local CAS cache copies after confirming the remote object, but never exact
# results, local-storage artifacts, or remote objects. Set the interval to 0 to
# disable periodic cleanup.
RIPCLONE_RETENTION_INTERVAL_SECS=300
RIPCLONE_RETENTION_MAX_GB=100

# ------------------------------------------------------------------------------
# Build / sync behaviour
# ------------------------------------------------------------------------------
# Poll interval for webhook-less self-hosts to self-heal missed or stuck builds
# (seconds). Set to 0 to disable.
RIPCLONE_POLL_INTERVAL_SECS=300
